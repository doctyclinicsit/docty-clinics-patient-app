# Copy this file to .env.local for local development. Never commit .env.local.
# Configure production values in the Vercel project's Environment Variables page.

# Public application URLs
PUBLIC_SITE_URL=https://example.com
SITE_URL=https://example.com
VITE_PUBLIC_SITE_URL=https://example.com
# VERCEL_PROJECT_PRODUCTION_URL is supplied automatically by Vercel.

# Database and file storage
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional database aliases supported by some endpoints:
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
# POSTGRES_PRISMA_URL=postgresql://user:password@host/dbname?sslmode=require
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Session and scheduled-job secrets (use independent, long random values)
PATIENT_SESSION_SECRET=replace-with-long-random-value
STAFF_SESSION_SECRET=replace-with-long-random-value
DOCTOR_SESSION_SECRET=replace-with-long-random-value
FRANCHISE_SESSION_SECRET=replace-with-long-random-value
CAMP_STATION_SESSION_SECRET=replace-with-long-random-value
CRON_SECRET=replace-with-long-random-value
STAFF_ACCESS_CODE=replace-with-private-access-code
STAFF_PASSWORD=replace-with-private-password

# Eka Care / EkaScribe (server-side)
EKA_AUTH_TOKEN=replace-with-eka-auth-token
EKA_CLIENT_ID=replace-with-eka-client-id

# eVitalRx
EVITALRX_API_BASE_URL=https://example-provider-api.invalid
EVITALRX_API_KEY=replace-with-evitalrx-api-key
EVITALRX_WEBHOOK_SECRET=replace-with-evitalrx-webhook-secret

# MSG91 OTP and WhatsApp messaging (server-side)
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_TEMPLATE_ID=replace-with-otp-template-id
MSG91_CAMP_OTP_TEMPLATE_ID=replace-with-camp-otp-template-id
MSG91_WHATSAPP_INTEGRATED_NUMBER=replace-with-sender-number
MSG91_WHATSAPP_TEMPLATE_NAME=replace-with-template-name
MSG91_WHATSAPP_TEMPLATE_LANGUAGE=en_US
MSG91_WHATSAPP_TEMPLATE_NAMESPACE=replace-with-template-namespace
MSG91_WHATSAPP_CARD_TEMPLATE_NAME=replace-with-card-template-name
MSG91_WHATSAPP_CARD_TEMPLATE_LANGUAGE=en_US
MSG91_WHATSAPP_CARD_TEMPLATE_NAMESPACE=replace-with-card-template-namespace
MSG91_WHATSAPP_CARD_ISSUED_TEMPLATE_NAME=replace-with-card-issued-template-name
MSG91_WHATSAPP_CARD_ISSUED_TEMPLATE_LANGUAGE=en_US
MSG91_WHATSAPP_CARD_ISSUED_TEMPLATE_NAMESPACE=replace-with-card-issued-template-namespace
MSG91_WHATSAPP_PHARMACY_DELIVERY_TEMPLATE_NAME=replace-with-delivery-template-name
MSG91_WHATSAPP_PHARMACY_DELIVERY_TEMPLATE_LANGUAGE=en_US
MSG91_WHATSAPP_PHARMACY_DELIVERY_TEMPLATE_NAMESPACE=replace-with-delivery-template-namespace
MSG91_WHATSAPP_PHARMACY_RECEIPT_TEMPLATE_NAME=replace-with-receipt-template-name
MSG91_WHATSAPP_PHARMACY_RECEIPT_TEMPLATE_LANGUAGE=en_US
MSG91_WHATSAPP_PHARMACY_RECEIPT_TEMPLATE_NAMESPACE=replace-with-receipt-template-namespace

# Zoho CRM OAuth/function configuration
ZOHO_CRM_LEAD_ENDPOINT=https://www.zohoapis.in/crm/v7/functions/your_function/actions/execute?auth_type=apikey&zapikey=replace-with-key
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.in
ZOHO_CRM_CLIENT_ID=replace-with-zoho-client-id
ZOHO_CRM_CLIENT_SECRET=replace-with-zoho-client-secret
ZOHO_CRM_REFRESH_TOKEN=replace-with-zoho-refresh-token
ZOHO_CRM_ACCESS_TOKEN=replace-with-short-lived-access-token
ZOHO_ACCESS_TOKEN=replace-with-short-lived-access-token
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_CRM_LEADS_MODULE=Leads
ZOHO_CRM_RECEIPTS_MODULE=replace-with-receipts-module
ZOHO_CRM_PHARMACY_SALES_MODULE=replace-with-pharmacy-sales-module
ZOHO_CRM_LEAD_FIELDS=replace-with-field-list
ZOHO_CRM_LEAD_STATUS_FIELD=replace-with-status-field
ZOHO_CRM_LEAD_REMARKS_FIELD=replace-with-remarks-field

# Zoho Books
ZOHO_BOOKS_ORGANIZATION_ID=replace-with-organization-id
ZOHO_BOOKS_REFRESH_TOKEN=replace-with-refresh-token
ZOHO_BOOKS_CLIENT_ID=replace-with-client-id
ZOHO_BOOKS_CLIENT_SECRET=replace-with-client-secret
ZOHO_BOOKS_ACCESS_TOKEN=replace-with-short-lived-access-token
ZOHO_BOOKS_API_DOMAIN=https://www.zohoapis.in
ZOHO_BOOKS_PHARMACY_CUSTOMER_ID=replace-with-customer-id
ZOHO_BOOKS_WALKIN_CUSTOMER_ID=replace-with-customer-id
ZOHO_BOOKS_SALES_ACCOUNT_ID=replace-with-account-id
ZOHO_BOOKS_PURCHASE_ACCOUNT_ID=replace-with-account-id
ZOHO_BOOKS_INVENTORY_ACCOUNT_ID=replace-with-account-id
ZOHO_BOOKS_ITEM_ACCOUNT_ID=replace-with-account-id
ZOHO_BOOKS_ITEM_SOURCE_CUSTOM_FIELD_ID=replace-with-custom-field-id

# Sharing and franchise access
EXECUTIVE_DASHBOARD_SHARE_TOKEN=replace-with-long-random-share-token
FRANCHISE_OPPORTUNITY_SHARE_TOKEN=replace-with-long-random-share-token

# Social media and AI features
SOCIAL_MEDIA_ENABLED=false
SOCIAL_PUBLISHING_ENABLED=false
META_ACCESS_TOKEN=replace-with-meta-access-token
GOOGLE_BUSINESS_CREDENTIALS=replace-with-json-credentials
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=replace-with-model-name

# Staff Administration OTP destination
STAFF_ADMIN_MOBILE=replace-with-authorized-mobile-number

# Optional browser-side development overrides. Do not expose server-side secrets
# with a VITE_ prefix because Vite bundles these values into client JavaScript.
# VITE_API_BASE_URL=http://localhost:3000
# VITE_EKA_PUBLIC_BASE_URL=https://example-provider-api.invalid
# VITE_EKA_AUTH_TOKEN=local-development-only
# VITE_EKA_BEARER_TOKEN=local-development-only
# VITE_EKA_CLIENT_ID=replace-with-client-id
